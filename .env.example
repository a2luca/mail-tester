# --- mailcow connection -------------------------------------------------
IMAP_HOST=mail.lucalutz.net
IMAP_PORT=993
SMTP_HOST=mail.lucalutz.net
SMTP_PORT=587
MAIL_USER=mail-test@lucalutz.net
MAIL_PASSWORD=change-me

# Hostname of your mailcow MX - used to pick the trusted Received /
# Authentication-Results headers. Must match what mailcow writes in "by ...".
MY_HOSTNAME=mail.lucalutz.net

# --- behaviour ------------------------------------------------------------
TRIGGER_SUBJECT=Mailtest
FOLDERS=INBOX,Junk
PROCESSED_FOLDER=Processed
POLL_SECONDS=30
PER_SENDER_LIMIT_PER_HOUR=5

# Alert when used more than ALERT_THRESHOLD times per day (once per day)
ALERT_TO=info@lucalutz.net
ALERT_THRESHOLD=5

# --- branding of the reply mail ---------------------------------------------
COMPANY_NAME=Luca Lutz Networks
CONTACT_ADDRESS=info@lucalutz.net
WEBSITE_URL=https://lucalutz.net
# PNG strongly recommended - Gmail and Outlook do not display SVG images
LOGO_URL=https://lucalutz.net/logo-llwn.svg

TZ=Europe/Berlin
# Optional: use a specific resolver instead of the container default
#DNS_SERVER=1.1.1.1,9.9.9.9
